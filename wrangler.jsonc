/**
 * Configuration for Cloudflare Workers & Pages deployment
 * AlzaVoz - Medellín
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alzavoz",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "out",
  "services": [{ "binding": "RECORDINGS", "service": "alzavoz-recordings" }],
  "vars": {
    "RECORDING_APP_ORIGIN": "https://alzavoz.pages.dev",
    "CONCEJAL_WHATSAPP": "+573234306794",
    "MEDELLIN_EMERGENCY_POLICE": "123",
    "LINEA_PURPURA": "155"
  }
}

