{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alzavoz-recordings",
  "main": "index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [{ "binding": "EVIDENCIAS", "bucket_name": "alzavoz-evidencias" }],
  "d1_databases": [{ "binding": "DB", "database_name": "alzavoz-db", "database_id": "3977754d-245c-48ca-bad3-4d297d0dd9e8", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "SESSION_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } }]
}
