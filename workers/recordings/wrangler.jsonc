{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alzavoz-recordings-preview",
  "main": "index.ts",
  "compatibility_date": "2024-11-01",
  "workers_dev": false,
  "r2_buckets": [{ "binding": "EVIDENCIAS", "bucket_name": "alzavoz-evidencias-pruebas", "preview_bucket_name": "alzavoz-evidencias-pruebas" }],
  "d1_databases": [{ "binding": "DB", "database_name": "alzavoz-db-pruebas", "database_id": "2c86c769-94f0-4367-8bc7-6e311e03c97a", "migrations_dir": "migrations" }],
  "unsafe": { "bindings": [{ "name": "SESSION_LIMITER", "type": "ratelimit", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } }] }
}
